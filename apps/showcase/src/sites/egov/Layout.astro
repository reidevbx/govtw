---
import Site from '../../layouts/Site.astro'
import { site } from './site'
import './theme.css'

interface Props {
  title: string
  current?: string
}

const { title, current } = Astro.props
---
<Site site={site} title={title} current={current}>
  <slot name="hero" slot="hero" />
  <slot />
</Site>
