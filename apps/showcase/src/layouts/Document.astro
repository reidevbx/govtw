---
import '@gov-tw/tokens/tokens.css'
import '../styles/base.css'

interface Props {
  title: string
}

const { title } = Astro.props
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import '@gov-tw/web-components'
    </script>
  </body>
</html>
